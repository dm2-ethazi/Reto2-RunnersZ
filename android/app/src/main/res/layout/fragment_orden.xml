<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder de Orden (I-06); la lógica completa es I-15. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_orden"
        android:textAppearance="@style/TextAppearance.RunnersZ.Titulo" />

    <TextView
        android:id="@+id/ayudaOrden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/orden_placeholder"
        android:textAppearance="@style/TextAppearance.RunnersZ.Ayuda" />
</LinearLayout>
