<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_orden"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_azul_hogwarts"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:startIconDrawable="@drawable/ic_text"
            app:startIconContentDescription="@string/a11y_campo_texto_cifrado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/orden_hint_texto"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:maxLines="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCargarTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cargar .txt / Load .txt"
            app:layout_constraintTop_toBottomOf="@id/tilTexto"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDesplazamiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:startIconDrawable="@drawable/ic_shift"
            app:startIconContentDescription="@string/a11y_campo_desplazamiento"
            app:layout_constraintTop_toBottomOf="@id/btnCargarTxt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDesplazamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/orden_hint_desplazamiento"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescifrarOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/orden_btn_descifrar"
            android:contentDescription="@string/a11y_btn_descifrar_orden"
            app:layout_constraintTop_toBottomOf="@id/tilDesplazamiento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_reintentar"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnDescifrarOrden"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvResultadoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/orden_label_resultado"
            android:textStyle="bold"
            android:textColor="@color/color_azul_hogwarts"
            app:layout_constraintTop_toBottomOf="@id/btnDescifrarOrden"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvResultadoLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/orden_hint_resultado"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:maxLines="6"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tilResultado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Listo para descifrar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
