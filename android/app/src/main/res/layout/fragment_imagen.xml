<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_imagen"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_azul_hogwarts"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArchivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_file"
            app:startIconContentDescription="@string/a11y_campo_archivo_enc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArchivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/imagen_label_archivo"
                android:focusable="false"
                android:clickable="true"
                android:focusableInTouchMode="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeleccionarArchivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/imagen_btn_seleccionar"
            app:layout_constraintTop_toBottomOf="@id/tilArchivo"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvArchivoSeleccionado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btnSeleccionarArchivo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Ningún archivo seleccionado" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilClave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:startIconDrawable="@drawable/ic_key"
            app:startIconContentDescription="@string/a11y_campo_clave_aes"
            app:endIconMode="password_toggle"
            app:layout_constraintTop_toBottomOf="@id/tvArchivoSeleccionado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/imagen_hint_clave"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescifrarImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/imagen_btn_descifrar"
            android:contentDescription="@string/a11y_btn_descifrar_imagen"
            app:layout_constraintTop_toBottomOf="@id/tilClave"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentarImagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_reintentar"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnDescifrarImagen"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/ivResultadoImagen"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/a11y_imagen_descifrada"
            android:background="@drawable/border_image"
            app:layout_constraintTop_toBottomOf="@id/btnDescifrarImagen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_imagen" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/imagen_label_estado"
            android:textStyle="bold"
            android:textColor="@color/color_azul_hogwarts"
            app:layout_constraintTop_toBottomOf="@id/ivResultadoImagen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEstadoValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/imagen_estado_listo"
            android:textColor="@color/color_text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tvEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoDescifrado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvEstadoValor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvMensajeImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvEstadoValor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Seleccioná un archivo .enc para comenzar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
